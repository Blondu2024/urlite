{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "urlite-x.vercel.app" }],
      "destination": "https://urlite.app/",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "urlite-x.vercel.app" }],
      "destination": "https://urlite.app/app",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/" },
    {
      "source": "/x/:id",
      "has": [{ "type": "host", "value": "urlite-x.vercel.app" }],
      "destination": "/api/link?id=:id&go=1"
    }
  ],
  "headers": [
    {
      "source": "/s/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/s",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/x/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
